# Development environment configuration

# Use mock server
UUDEX_SERVER_MODE=mock
UUDEX_API_URL=http://localhost:8400

# Reflex configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8240
FRONTEND_PORT=8555
# REFLEX_API_URL=http://localhost:8240
# REFLEX_BACKEND_URL=http://localhost:8240
# REFLEX_EVENT_URL=ws://localhost:8240/_event
LOGLEVEL=info

# Development-specific settings
PYTHONUNBUFFERED=1

# TTL for the uudex_api_client.Client cache (in seconds)
CLIENT_CACHE_TTL=600
