{
    // Python configuration
    "python.defaultInterpreterPath": "./.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.analysis.extraPaths": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/tests"
    ],

    // Enable automatic linting and formatting
    "python.linting.enabled": false,  // Disable legacy linting
    "python.formatting.provider": "none",
    
    // Ruff configuration (linting + formatting)
    "ruff.enable": true,
    "ruff.organizeImports": true,
    "ruff.fixAll": true,
    "ruff.showSyntaxErrors": true,
    "ruff.args": [
        "--config=${workspaceFolder}/pyproject.toml"
    ],
    
    // MyPy type checking (handled by extension)
    "mypy-type-checker.args": [
        "--config-file=${workspaceFolder}/pyproject.toml",
        "--show-column-numbers",
        "--no-pretty"
    ],
    
    // Format on save settings
    "[python]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit",
            "source.fixAll.ruff": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    
    // File associations
    "files.associations": {
        "*.py": "python",
        "*.pyi": "python"
    },
    
    // Exclude patterns from file watcher
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        ".pytest_cache": true,
        ".coverage": true,
        "htmlcov": true,
        ".mypy_cache": true,
        ".ruff_cache": true
    },
    
    // Test configuration
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests"
    ],
    
    // Editor settings for Python
    "editor.rulers": [88, 100],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.trimAutoWhitespace": true,
    
    // Terminal settings
    "terminal.integrated.env.linux": {
        "PYTHONPATH": "${workspaceFolder}/src"
    }
}
